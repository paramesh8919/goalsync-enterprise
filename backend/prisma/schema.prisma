// GoalSync Enterprise Platform — Prisma Schema (v2: Enterprise Hierarchy)
// Works with any Postgres database (Neon, Supabase, Railway, ElephantSQL, etc.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  TEAM_LEADER
  EMPLOYEE
}

// Self-registration approval state for TEAM_LEADER / EMPLOYEE accounts.
// ADMIN and MANAGER accounts are created directly by the org (never PENDING).
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  DRAFT // being assembled by Team Leader, not yet submitted
  PENDING_APPROVAL // submitted, awaiting Manager + Admin decisions
  ACTIVE // both Manager and Admin approved
  REJECTED // either Manager or Admin rejected — terminal, cannot resubmit
  COMPLETED
  ON_HOLD
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  CLOSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  VACATION
  PERSONAL
  UNPAID
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WORK_FROM_HOME
}

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  PROJECT_SUBMITTED
  PROJECT_APPROVED
  PROJECT_REJECTED
  PROJECT_ACTIVATED
  TASK_ASSIGNED
  TASK_UPDATED
  MILESTONE_DUE
  LEAVE_REQUESTED
  LEAVE_DECIDED
  RISK_RAISED
  ANNOUNCEMENT
  TEAM_ASSIGNED
  SYSTEM
}

// ---------------------------------------------------------------------------
// ORGANIZATION / IDENTITY
// ---------------------------------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  teams       Team[]
  createdAt   DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(EMPLOYEE)

  jobTitle  String?
  skills    String[] @default([]) // used for skill-based team formation
  avatarUrl String?
  phone     String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // --- Self-registration dual-approval (TEAM_LEADER / EMPLOYEE only) ---
  approvalStatus    ApprovalStatus @default(APPROVED) // ADMIN/MANAGER created directly -> APPROVED
  managerApprovedBy String?
  managerApprovedAt DateTime?
  adminApprovedBy   String?
  adminApprovedAt   DateTime?
  rejectionReason   String?
  isActive          Boolean        @default(true) // false until fully approved, for EMPLOYEE/TEAM_LEADER

  // --- Reporting hierarchy ---
  managerId String?
  manager   User?   @relation("ManagerToUser", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerToUser")

  // A Team Leader's team; an Employee's membership in a team
  ledTeam Team?   @relation("TeamLeaderOf")
  teamId  String?
  team    Team?   @relation("TeamMembers", fields: [teamId], references: [id])

  // --- Relations to work items ---
  projectsCreated     Project[]          @relation("ProjectCreatedBy")
  tasksAssigned       Task[]             @relation("TaskAssignee")
  documentsUploaded   ProjectDocument[]  @relation("DocumentUploadedBy")
  leaveRequests       LeaveRequest[]     @relation("LeaveRequester")
  leaveDecisions      LeaveRequest[]     @relation("LeaveDecider")
  attendanceRecords   Attendance[]
  risksRaised         Risk[]             @relation("RiskRaisedBy")
  notifications       Notification[]
  chatMessages        ChatMessage[]
  calendarEvents      CalendarEvent[]    @relation("EventCreatedBy")
  announcementsPosted Announcement[]     @relation("AnnouncementPostedBy")
  auditLogs           AuditLog[]
  performanceScores   PerformanceScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([managerId])
  @@index([teamId])
  @@index([departmentId])
  @@index([approvalStatus])
}

model Team {
  id          String  @id @default(uuid())
  name        String
  description String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  leaderId String @unique
  leader   User   @relation("TeamLeaderOf", fields: [leaderId], references: [id])

  members  User[]    @relation("TeamMembers")
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// PROJECTS — dual-approval workflow (Manager + Admin)
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid())
  title       String
  description String
  priority    Priority      @default(MEDIUM)
  status      ProjectStatus @default(DRAFT)

  startDate DateTime?
  dueDate   DateTime?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  // --- Dual approval ---
  managerDecision     ApprovalDecision @default(PENDING)
  managerDecisionById String?
  managerDecisionAt   DateTime?
  managerComment      String?

  adminDecision     ApprovalDecision @default(PENDING)
  adminDecisionById String?
  adminDecisionAt   DateTime?
  adminComment      String?

  submittedAt DateTime?

  milestones   Milestone[]
  tasks        Task[]
  documents    ProjectDocument[]
  risks        Risk[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([createdById])
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  status      MilestoneStatus @default(NOT_STARTED)
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  progress    Int        @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([milestoneId])
  @@index([status])
}

model ProjectDocument {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String // path/URL to stored file (see storage notes in README)
  fileType     String?
  fileSize     Int?
  uploadedById String
  uploadedBy   User     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Risk {
  id             String       @id @default(uuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  severity       RiskSeverity @default(MEDIUM)
  status         RiskStatus   @default(OPEN)
  mitigationPlan String?
  raisedById     String
  raisedBy       User         @relation("RiskRaisedBy", fields: [raisedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// HR MODULES
// ---------------------------------------------------------------------------

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("LeaveRequester", fields: [userId], references: [id])
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)
  decidedById String?
  decidedBy   User?       @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  comment     String?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

model Attendance {
  id       String           @id @default(uuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  date     DateTime
  status   AttendanceStatus @default(PRESENT)
  checkIn  DateTime?
  checkOut DateTime?
  notes    String?

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model PerformanceScore {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  tasksCompleted Int      @default(0)
  onTimeRate     Float    @default(0) // 0-100
  score          Float    @default(0) // computed composite 0-100
  createdAt      DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// COLLABORATION / SYSTEM
// ---------------------------------------------------------------------------

model ChatMessage {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId    String?
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([teamId])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  projectId   String?
  createdById String
  createdBy   User     @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([startAt])
  @@index([projectId])
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  body       String
  postedById String
  postedBy   User     @relation("AnnouncementPostedBy", fields: [postedById], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "PROJECT_APPROVED", "USER_REJECTED"
  entity    String // e.g. "Project", "User"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}
