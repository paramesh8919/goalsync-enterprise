# --- Database (Postgres connection string) ---
# Get a free one from Neon (https://neon.tech), Supabase (https://supabase.com),
# Railway, or any Postgres host. See the README "Database setup" section.
DATABASE_URL="postgresql://postgres:Naru1234@localhost:5432/goalsync"

# --- Auth ---
# Generate your own secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_YOUR_OWN_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS / Frontend ---
CLIENT_URL="http://localhost:3000"

# --- Escalation Engine ---
# Cron schedule for the escalation/reminder sweep (default: every hour)
ESCALATION_CRON="0 * * * *"
# Days a project can stay in PENDING_APPROVAL before it's escalated to admins
ESCALATION_THRESHOLD_DAYS=3
# Days before a task's dueDate to send a "due soon" reminder
DUE_SOON_REMINDER_DAYS=2
